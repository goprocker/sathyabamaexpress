# ── Frontend (apps/web) — Vite-exposed, safe for the browser ──────────────
# Base URL of the API. When empty, apps/web runs against deterministic mock data.
VITE_API_URL=

# ── Backend (apps/api) — server-only secrets, NEVER referenced in frontend ─
# TRD §33: no provider API keys in frontend; agents cannot access secrets.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2

# ── SnapServe voice agent (app.snapserve.ai) ────────────────────────────────
# Without SNAPSERVE_API_KEY the deterministic demo simulator is used.
# With it, real outbound calls go through the active SnapServe agent.
# SNAPSERVE_API_KEY=sk_live_xxx
# REST base for the dashboard API (default: https://app.snapserve.ai/api)
# SNAPSERVE_BASE_URL=https://app.snapserve.ai/api
# Pin a specific agent; otherwise the first ACTIVE agent on the account is
# auto-resolved via GET /agents ("the active one which has a number").
# SNAPSERVE_AGENT_ID=
# Caller number shown to vendors — auto-resolved from the agent's assigned
# number (GET /phone-numbers) when left empty. Set only to override.
# SNAPSERVE_AGENT_NUMBER=
# Outbound call status polling (live mode). Webhook below is optional.
# SNAPSERVE_POLL_INTERVAL_MS=2500
# SNAPSERVE_CALL_TIMEOUT_MS=120000
# HMAC secret for POST /api/webhooks/snapserve (X-Snapserve-Signature verify)
# SNAPSERVE_WEBHOOK_SECRET=
# Set to "false" to fail loudly instead of falling back to the demo simulator
# on transient SnapServe API errors.
# SNAPSERVE_ALLOW_SIMULATOR_FALLBACK=true
# Legacy demo knobs (simulator mode only)
# SNAPSERVE_DEMO_VENDOR_PHONE=+919840000000

# APPROVAL_HMAC_SECRET=
# APPROVAL_TOKEN_TTL_MINUTES=15
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
