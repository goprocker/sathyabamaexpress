# ── Frontend (apps/web) — Vite-exposed, safe for the browser ──────────────
# Base URL of the API. When empty, apps/web runs against deterministic mock data.
VITE_API_URL=

# ── Backend (apps/api) — server-only secrets, NEVER referenced in frontend ─
# TRD §33: no provider API keys in frontend; agents cannot access secrets.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2

# ── Inventory restock ───────────────────────────────────────────────────────
# Items that are out of stock, below their reorder level, or expiring within
# 36 h become one approval-ready vendor call per vendor (Actions screen).
# Approving places the order through SnapServe. The long-running server also
# re-checks every household on this timer (minutes; 0 = off). Serverless hosts
# can call POST /api/reorders/scan from a cron instead.
# REORDER_SCAN_INTERVAL_MINUTES=30

# ── Phone ordering ──────────────────────────────────────────────────────────
# Call the ordering line from your registered phone (Stores screen), say what
# you need; the app calls the right store. Set up the two Snapserve agents with:
#   (from apps/api) node_modules/.bin/tsx ../../scripts/setup-order-agents.ts +91XXXXXXXXXX
# which prints these values. SNAPSERVE_AGENT_ID (below) should be the
# "Household Store Caller" agent it creates.
# SNAPSERVE_ORDER_AGENT_ID=
# SNAPSERVE_ORDER_NUMBER=+91XXXXXXXXXX
# SNAPSERVE_ORDER_POLL_MS=15000
# Only one server may watch the line (else two could call the store). Default:
# on when NODE_ENV=production, off otherwise. Force with on/off.
# PHONE_ORDER_WATCHER=

# ── SnapServe voice agent (app.snapserve.ai) ────────────────────────────────
# Without SNAPSERVE_API_KEY the deterministic demo simulator is used.
# With it, real outbound calls go through the active SnapServe agent.
# SNAPSERVE_API_KEY=sk_live_xxx
# REST base for the dashboard API (default: https://app.snapserve.ai/api)
# SNAPSERVE_BASE_URL=https://app.snapserve.ai/api
# Pin a specific agent; otherwise the first ACTIVE agent on the account is
# auto-resolved via GET /agents ("the active one which has a number").
# SNAPSERVE_AGENT_ID=
# Caller number shown to vendors — auto-resolved from the agent's assigned
# number (GET /phone-numbers) when left empty. Set only to override.
# SNAPSERVE_AGENT_NUMBER=
# Outbound call status polling (live mode). Webhook below is optional.
# SNAPSERVE_POLL_INTERVAL_MS=2500
# SNAPSERVE_CALL_TIMEOUT_MS=120000
# HMAC secret for POST /api/webhooks/snapserve (X-Snapserve-Signature verify)
# SNAPSERVE_WEBHOOK_SECRET=
# Set to "false" to fail loudly instead of falling back to the demo simulator
# on transient SnapServe API errors.
# SNAPSERVE_ALLOW_SIMULATOR_FALLBACK=true
# The seeded demo vendors have placeholder numbers. Set this to a phone you own
# and live calls to those vendors ring it instead (real vendors are unaffected).
# SNAPSERVE_DEMO_VENDOR_PHONE=+91XXXXXXXXXX

# APPROVAL_HMAC_SECRET=
# APPROVAL_TOKEN_TTL_MINUTES=15
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# ── Clerk authentication (optional) ─────────────────────────────────────────
# Leave both unset to run the app open, as in local demos.
# Create an application at https://dashboard.clerk.com, then copy the keys.
# Browser-safe publishable key (pk_test_... / pk_live_...):
VITE_CLERK_PUBLISHABLE_KEY=
# Server-only secret key (sk_test_... / sk_live_...). When set, the API requires
# a valid Clerk session token on every route except /api/health and /api/ready.
CLERK_SECRET_KEY=
# Optional: comma-separated web origins allowed to mint tokens (e.g. https://app.example.com)
CLERK_AUTHORIZED_PARTIES=

# ── Per-user storage (optional locally, required on Vercel) ─────────────────
# Postgres connection string. Each signed-in user's household is stored in a
# livora_user_state table, created automatically. Without it, users are saved
# as files under apps/api/.data/users/ (not durable on serverless hosts).
DATABASE_URL=

# ── Uploaded documents (Setup) ──────────────────────────────────────────────
# Aadhaar, PAN, licence and bill photos are encrypted (AES-256-GCM) before they are stored.
# By default the key is derived from CLERK_SECRET_KEY. Set this to use a dedicated key instead
# (32+ random bytes, base64 or hex, for example: openssl rand -base64 32).
# Keep it stable: files stored under an old key cannot be read after it changes.
DOCUMENT_ENCRYPTION_KEY=

# Optional: email of the shared account behind "Try the demo" on the sign-in page (default demo@livora.app).
# The demo signs in through Clerk; it is created on first use and needs CLERK_SECRET_KEY on the server.
DEMO_USER_EMAIL=
